{
  "name": "token-safety-check",
  "version": "0.4.1",
  "description": "Rug check any token on Base, Ethereum, Arbitrum, Optimism, Polygon or Solana: a 0-100 risk score with plain reasons, a CLEAN/MID/SKETCHY/RUGGY verdict with a share card, and a watchlist that re-checks up to 5 tokens per call. Pays $0.01 per call in USDC on Base via x402. Includes an MCP server, Vercel AI SDK tools and an ElizaOS plugin.",
  "mcpName": "io.github.lx1112/token-safety-check",
  "type": "module",
  "license": "MIT",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/lx1112/token-safety-check.git"
  },
  "homepage": "https://github.com/lx1112/token-safety-check#readme",
  "bugs": {
    "url": "https://github.com/lx1112/token-safety-check/issues"
  },
  "main": "dist/index.js",
  "types": "dist/index.d.ts",
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "default": "./dist/index.js"
    },
    "./ai": {
      "types": "./dist/ai.d.ts",
      "default": "./dist/ai.js"
    },
    "./eliza": {
      "types": "./dist/eliza.d.ts",
      "default": "./dist/eliza.js"
    }
  },
  "bin": {
    "token-safety-check": "dist/mcp.js"
  },
  "files": [
    "dist",
    "README.md",
    "LICENSE"
  ],
  "engines": {
    "node": ">=20"
  },
  "keywords": [
    "ai-agent",
    "ai-sdk",
    "base",
    "crypto",
    "elizaos",
    "elizaos-plugin",
    "ethereum",
    "mastra",
    "mcp",
    "rug-check",
    "solana",
    "token",
    "x402"
  ],
  "scripts": {
    "build": "tsc -p tsconfig.json && chmod +x dist/mcp.js",
    "prepublishOnly": "npm run build",
    "pack:mcpb": "sh scripts/pack-mcpb.sh"
  },
  "dependencies": {
    "@modelcontextprotocol/sdk": "1.32.1",
    "@x402/evm": "2.28.0",
    "@x402/fetch": "2.28.0",
    "viem": "2.57.8",
    "zod": "3.25.76"
  },
  "devDependencies": {
    "@types/node": "26.6.5",
    "typescript": "7.0.2"
  }
}
